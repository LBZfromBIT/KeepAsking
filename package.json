{
  "name": "branch-chat",
  "productName": "BranchChat",
  "version": "0.1.0",
  "description": "分支对话：支持划词展开分支与实时对话树的 AI 桌面客户端（BYOK）",
  "main": "./out/main/index.js",
  "author": {
    "name": "Luis Liu",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/OWNER/branch-chat",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "mock": "node mock/mock-server.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.2.4",
    "playwright-core": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "desktopName": "branchchat.desktop",
  "engines": {
    "node": ">=22.12.0"
  }
}
